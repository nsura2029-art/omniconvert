# OmniConvert environment template
# =============================================================================
# Copy this file to .env.local for local development. Never commit real secrets.
# Each section maps to one of: Vite (VITE_*), Cloudflare (CLOUDFLARE_*),
# GitHub Actions secrets/vars (the section headers tell you which).
#
# All CLOUDFLARE_* values that are not secrets belong in wrangler.toml [vars].
# Values that ARE secrets (tokens, keys) belong in GitHub repo secrets (and
# .env.local for local dev). IDs and resource names are not strictly secrets
# but should still be configured via wrangler.toml where possible.
# =============================================================================


# ===== App / runtime (Vite + GH vars) ==========================================
APP_ENV="local"
APP_URL="http://localhost:3000"
VITE_APP_ENV="local"
VITE_APP_URL="http://localhost:3000"

# Public API base the SPA talks to. Same-origin in production:
#   prod:  https://omniconvert.com/api/v1
#   local: http://localhost:8787/api/v1  (wrangler dev port)
# Set as VITE_* so the React bundle can read it at build time.
VITE_API_BASE_URL="http://localhost:8787/api/v1"


# ===== AI provider (GH secret) =================================================
# Required only when server-side Gemini/API features are wired in.
GEMINI_API_KEY="MY_GEMINI_API_KEY"


# ===== Authentication (GH secret, future) ======================================
# Current app auth is a localStorage sandbox in src/components/AuthModal.tsx.
# Use these if/when Clerk is added.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"


# ===== Database (GH secret, future) ============================================
# Current app data is stored in browser localStorage.
# For Cloudflare D1, create the DB, add the binding in wrangler.toml, and keep
# the id in GitHub secrets.
CLOUDFLARE_D1_DATABASE_ID="REPLACE_WITH_D1_DATABASE_ID"
DATABASE_URL="file:local.db"


# ===== Cloudflare account (GH secret) ==========================================
# Found at https://dash.cloudflare.com -> Workers & Pages -> right sidebar.
# Used by the deploy workflow and wrangler locally.
CLOUDFLARE_ACCOUNT_ID="f0de6c4b68becd81e60507ecf9410199"
CLOUDFLARE_API_TOKEN="cfut_bu51cHpSTzVkRxvAuLrUr7Ze2Q0K9cOp5hQxzd6j6569c49c"


# ===== Cloudflare Workers (GH vars, mirrored in wrangler.toml [vars]) ==========
# Friendly worker names. Must be unique per Cloudflare account.
# Mirror these in each worker's wrangler.toml `name = "..."` field.
CF_WORKER_NAME_SPA="omni-spa"
CF_WORKER_NAME_API="omni-api"
CF_WORKER_NAME_CAD="omni-cad-worker"
# Add more category workers here as you ship them (see workers/<name>/wrangler.toml).


# ===== Cloudflare Workers custom domain (GH vars, optional) ====================
# Once DNS is set up in Cloudflare, point a custom domain at the API worker.
# Same-origin in production means the SPA can call /api/* without CORS.
CF_API_CUSTOM_DOMAIN="api.omniconvert.com"
# If you prefer a workers.dev subdomain (free, no DNS):
# CF_API_CUSTOM_DOMAIN=""


# ===== Cloudflare KV namespaces (wrangler.toml bindings, no env var needed) ====
# Create one per namespace with:
#   wrangler kv:namespace create JOBS --compatibility-date 2026-06-26
#   wrangler kv:namespace create RATE --compatibility-date 2026-06-26
# Paste the resulting IDs into the [[kv_namespaces]] blocks in wrangler.toml.
# This file just documents the names so the team knows what exists.
#
#   KV_JOBS_ID      — job state, idempotency keys, output pointers
#   KV_JOBS_PREVIEW — preview binding for local dev (created with --preview)
#   KV_RATE_ID      — per-IP rate-limit counters
#   KV_RATE_PREVIEW — local dev binding for KV_RATE


# ===== Cloudflare R2 buckets (wrangler.toml bindings) ==========================
# Create one per bucket with:
#   wrangler r2 bucket create omni-artifacts
#   wrangler r2 bucket create omni-staging
# Then reference them in each worker's wrangler.toml [[r2_buckets]] block.
#
#   R2_ARTIFACTS — final converted outputs (24h signed URLs from SPA)
#   R2_STAGING   — gateway drops incoming file here, consumer reads it


# ===== Cloudflare Queues (wrangler.toml bindings) ==============================
# Create one per category with:
#   wrangler queues create jobs-cad
#   wrangler queues create jobs-docs
#   wrangler queues create jobs-audio
# Then reference them in the relevant worker's wrangler.toml.
# Each consumer worker binds the same queue name to consume.
#
#   QUEUE_CAD, QUEUE_DOCS, QUEUE_AUDIO, QUEUE_VIDEO, QUEUE_EBOOKS, QUEUE_3D
# Add as you ship the corresponding worker.


# ===== Cloudflare Workers WASM modules (wrangler.toml bindings) =================
# Large engine binaries must be uploaded via:
#   wrangler wasm-module create --name occt <opencascade.wasm>
#   wrangler wasm-module create --name ffmpeg <ffmpeg-core.wasm>
# Then bind in the consumer worker's wrangler.toml:
#   [[wasm_modules]]
#   name = "occt"
#   part = "open_cascade"
#
# Track the names you choose here so you remember which binary they point at:
#   CF_WASM_MODULE_OCCT="occt"
#   CF_WASM_MODULE_FFMPEG="ffmpeg"


# ===== Cloud engine API keys (GH secret, used by docs/ebooks proxies) ==========
# Pick a provider (FilePreviews, CadExchanger, Aspose, your own) and drop the
# key here. These are NEVER committed; CI pulls them from GH repo secrets.
CLOUD_ENGINE_API_KEY="REPLACE_WITH_PROVIDER_KEY"
CLOUD_ENGINE_BASE_URL="https://api.provider.com/v1"


# ===== GitHub Actions secrets (set at repo Settings -> Secrets and variables) =
# GH SECRETS:
#   CLOUDFLARE_API_TOKEN       same value as CLOUDFLARE_API_TOKEN above
#   CLOUDFLARE_ACCOUNT_ID      same value as CLOUDFLARE_ACCOUNT_ID above
#   GEMINI_API_KEY             same value as GEMINI_API_KEY above
#   CLERK_SECRET_KEY           (future) same value as CLERK_SECRET_KEY above
#   CLOUD_ENGINE_API_KEY       same value as CLOUD_ENGINE_API_KEY above
#
# GH VARIABLES:
#   APP_URL                    e.g. https://omniconvert.com
#   VITE_APP_URL               same value, exposed at build time
#   VITE_APP_ENV               production
#   VITE_API_BASE_URL          same-origin path: /api/v1
#   CF_WORKER_NAME_SPA         same as above
#   CF_WORKER_NAME_API         same as above
#   CF_WORKER_NAME_CAD         same as above
#   CF_API_CUSTOM_DOMAIN       same as above
#
# KV / R2 / Queue IDs are NOT secrets. They live in wrangler.toml after the
# one-time `wrangler kv:namespace create` / `wrangler r2 bucket create` /
# `wrangler queues create` calls. Do NOT paste them into .env files.
