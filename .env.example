# OmniConvert environment template
# Copy this file to .env.local for local development.
# Never commit real secrets.

# App/runtime
APP_ENV="local"
APP_URL="http://localhost:3000"
VITE_APP_ENV="local"
VITE_APP_URL="http://localhost:3000"

# AI provider
# Required only when server-side Gemini/API features are wired in.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Authentication - not currently wired in code.
# Current app auth is a localStorage sandbox in src/components/AuthModal.tsx.
# Use these if/when Clerk is added.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"

# Database - not currently wired in code.
# Current app data is stored in browser localStorage.
# For Cloudflare D1, create the DB, add the binding in wrangler.toml, and keep the id in GitHub secrets/vars.
CLOUDFLARE_D1_DATABASE_ID="REPLACE_WITH_D1_DATABASE_ID"
DATABASE_URL="file:local.db"

# Cloudflare deployment
# Prefer storing these in GitHub repository secrets, not in .env.local.
CLOUDFLARE_ACCOUNT_ID="REPLACE_WITH_ACCOUNT_ID"
CLOUDFLARE_API_TOKEN="REPLACE_WITH_API_TOKEN"
